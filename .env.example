# Every secret lives in the environment, never in the database (NFR-1).
# Copy to .env (never committed) and fill in.

# Managed Postgres (web, gateway)
DATABASE_URL=postgres://clauderon:clauderon@localhost:54329/clauderon
# Postgres server used by tests; each test file creates and drops its own database
TEST_DATABASE_URL=postgres://clauderon:clauderon@localhost:54329/clauderon

# Google OAuth client in the company's Google Cloud project (web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret for Auth.js (CSRF and cookie signing) (web, gateway)
SESSION_SECRET=
# Public origin of the web app, e.g. https://clauderon.example.com (web)
AUTH_URL=http://localhost:3000

# Comma-separated emails that are always allowed and manage the allowlist (web, gateway)
OPERATOR_EMAILS=

# Long-lived shared secret for the Host Agent link (gateway, host-agent)
HOST_AGENT_SECRET=
# wss://… of the Gateway (web, host-agent)
GATEWAY_URL=ws://localhost:4000
# Port the Gateway listens on (gateway)
GATEWAY_PORT=4000
# Internal URL the web app uses to publish events to the Gateway (web)
GATEWAY_INTERNAL_URL=http://localhost:4000

# Host Agent state directory, holds the last received message id (host-agent)
HOST_AGENT_STATE_DIR=/var/lib/clauderon-host-agent

# Fine-grained read-only GitHub token (web, gateway; used from M1)
GITHUB_TOKEN=
# Current Pod image tag (gateway; used from M1)
POD_IMAGE=ghcr.io/OWNER/clauderon-pod:2026-11-16
# Chance 0 to 1 that a simulated Dry-run Node fails (gateway)
DRY_RUN_FAILURE_RATE=0
# Max Slots, CPU and RAM per Pod (web; used from M1)
POD_LIMIT_CEILING=slots=4,cpus=4,memoryMb=8192
