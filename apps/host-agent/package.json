{
  "name": "@clauderon/host-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "start": "tsx src/main.ts",
    "pair": "tsx src/main.ts pair",
    "watch": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@clauderon/core": "workspace:*",
    "@clauderon/protocol": "workspace:*",
    "dockerode": "^5.0.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@clauderon/testing": "workspace:*",
    "@types/dockerode": "^4.0.2",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2"
  }
}
