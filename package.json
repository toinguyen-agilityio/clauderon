{
  "name": "clauderon",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "pnpm --filter @clauderon/db migrate",
    "db:seed": "pnpm --filter @clauderon/db seed",
    "start:gateway": "pnpm db:migrate && pnpm --filter @clauderon/gateway start"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
