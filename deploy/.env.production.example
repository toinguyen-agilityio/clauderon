# Production settings for deploy/compose.yml. Copy to deploy/.env.production
# (git-ignored) and fill in. Secrets live here and in the containers' env only (NFR-1).
# Generate each secret with: openssl rand -base64 32

# Postgres password for the clauderon user (local container, never published)
POSTGRES_PASSWORD=

# Auth.js cookie signing and Gateway tickets (web, gateway)
SESSION_SECRET=
# Shared secret of the Host Agent link (gateway; the Host Agent gets the same value)
HOST_AGENT_SECRET=

# Google OAuth client; redirect URI: <PUBLIC_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Tailscale Serve URLs of this machine, e.g. https://pod-host.tail1234.ts.net
PUBLIC_URL=
# Same host, port 8443, as a WebSocket URL, e.g. wss://pod-host.tail1234.ts.net:8443
PUBLIC_GATEWAY_URL=

# Comma-separated emails that are always allowed and manage the allowlist
OPERATOR_EMAILS=

# Fine-grained read-only GitHub token
GITHUB_TOKEN=
# Pod image: a tag built on this machine (docker build -t clauderon-pod:local images/pod)
# or one published to GHCR by the Pod image workflow
POD_IMAGE=clauderon-pod:local
# Max Slots, CPU and RAM per Pod; on a 16 GB machine shared by 6 Members, 2 GB each leaves room for the stack
POD_LIMIT_CEILING=slots=2,cpus=2,memoryMb=2048
